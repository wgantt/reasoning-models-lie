# API Keys for different model providers
# Uncomment and set the ones you need

# Anthropic (Claude) API Key
# Get from: https://console.anthropic.com/
# export ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (for GPT-5 models)
# Get from: https://platform.openai.com/
# OPENAI_API_KEY=your_openai_api_key_here

# Together API Key (for DeepSeek, Kimi, Qwen, GPT-OSS access)
# TOGETHER_API_KEY=your_together_api_key_here

# HuggingFace API Key (for GPQA access)
# export HUGGINGFACE_API_TOKEN=your_huggingface_api_key_here

# Optional: Disable Langsmith logging
# export LANGCHAIN_TRACING_V2=false
# export LANGSMITH_TRACING=false
